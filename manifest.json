{
  "manifest_version": 3,
  "name": "Агент для DeepSeek",
  "version": "0.9.0",
  "minimum_chrome_version": "120",
  "description": "Локальный браузерный агент с веб-чатом DeepSeek и Python",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "debugger",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Агент для DeepSeek"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; connect-src 'self' https://pypi.org https://files.pythonhosted.org https://cdn.jsdelivr.net; base-uri 'none';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "executor.html",
        "src/chat-dom.js",
        "src/final-view.js",
        "src/ui-state.js",
        "src/chat-scroll.js",
        "src/tool-format.js"
      ],
      "matches": [
        "https://chat.deepseek.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "src/chat-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
